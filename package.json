{
  "name": "cloudmart",
  "version": "1.0.0",
  "private": true,
  "description": "CloudMart E-Commerce Microservices Platform on Google Cloud (GKE Autopilot, Cloud SQL PostgreSQL, Cloud Pub/Sub)",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test apps/product-service/test/product.spec.mjs apps/cart-service/test/cart.spec.mjs apps/order-service/test/order.spec.mjs apps/payment-service/test/payment.spec.mjs apps/notification-service/test/notification.spec.mjs tests/cloudmart-architecture.test.mjs",
    "typecheck": "tsc --build tsconfig.json",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
