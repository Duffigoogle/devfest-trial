// Payment Service Isolated PostgreSQL Schema (payment_db)
// Connected via dedicated role: svc_payment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PaymentTransaction {
  id                      String   @id @default(uuid()) @db.Uuid
  orderId                 String   @unique @map("order_id") @db.Uuid
  providerPaymentIntentId String   @unique @map("provider_payment_intent_id")
  clientSecret            String   @map("client_secret")
  amountCents             Int      @map("amount_cents")
  currency                String   @default("USD")
  status                  String   // INTENT_CREATED | SUCCEEDED | FAILED | REFUNDED
  failureReason           String?  @map("failure_reason")
  refunds                 Refund[]
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("payment_transactions")
}

model PaymentIdempotencyKey {
  idempotencyKey String   @id @map("idempotency_key")
  orderId        String   @map("order_id") @db.Uuid
  responseStatus String   @map("response_status")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("payment_idempotency_keys")
}

model Refund {
  id                   String             @id @default(uuid()) @db.Uuid
  paymentTransactionId String             @map("payment_transaction_id") @db.Uuid
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  amountCents          Int                @map("amount_cents")
  reason               String
  status               String             // PENDING | COMPLETED
  createdAt            DateTime           @default(now()) @map("created_at")

  @@map("refunds")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  topic         String
  eventType     String    @map("event_type")
  correlationId String    @map("correlation_id")
  payload       Json
  publishedAt   DateTime? @map("published_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
