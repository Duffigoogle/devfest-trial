{
  "name": "cloudmart-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CloudMart microservices monorepo for Google Cloud live demo",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "start": "node scripts/start-all.js",
    "test": "npm test --workspaces --if-present",
    "start:frontend": "npm --workspace=@cloudmart/frontend start",
    "start:product": "npm --workspace=@cloudmart/product start",
    "start:cart": "npm --workspace=@cloudmart/cart start",
    "start:order": "npm --workspace=@cloudmart/order start",
    "start:payment": "npm --workspace=@cloudmart/payment start",
    "start:notification": "npm --workspace=@cloudmart/notification start"
  }
}
