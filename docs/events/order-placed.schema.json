{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmart.demo.googlecloud.com/schemas/events/order.placed.json",
  "title": "order.placed",
  "description": "Emitted by the Order Service when a customer order is placed and paid.",
  "type": "object",
  "required": [
    "orderId",
    "items",
    "total",
    "customerEmail",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "eventType": {
      "type": "string",
      "const": "order.placed",
      "description": "Event type discriminator."
    },
    "orderId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the placed order.",
      "examples": ["ord-1732641000-a1b2"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "Line items included in the order.",
      "items": {
        "type": "object",
        "required": ["productId", "name", "quantity", "price"],
        "additionalProperties": false,
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "total": {
      "type": "number",
      "minimum": 0,
      "description": "Total order charge amount."
    },
    "customerEmail": {
      "type": "string",
      "format": "email",
      "description": "Customer email address for order confirmation notifications."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the order was created."
    }
  }
}
